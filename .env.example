# Copy this file to .env.local and fill in private values for local development.
# Keep .env.local out of version control; never use NEXT_PUBLIC_ for secrets.

# Database Security (SSL verification enforced by default)
DATABASE_URL=
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication Security (JWT Session Signing Key)
JWT_SECRET=

# Network & CORS Security
ALLOWED_ORIGIN=https://thegccfoundation.com
FRONTEND_URL=https://thegccfoundation.com
NEXT_PUBLIC_APP_URL=https://thegccfoundation.com

# Optional: override the default Workers AI model used by HopeBot on Cloudflare
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
